rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Profile avatars: owner can upload/update up to 5MB image; any signed-in user can read
    match /avatars/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
                      request.auth.uid == userId &&
                      request.resource.size <= 5 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
    }

    // Chat media (images, videos, voice notes, documents): signed-in upload up to 50MB
    match /chat_media/{chatId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
                      request.resource.size <= 50 * 1024 * 1024;
    }

    // Status media (images, videos): owner-scoped upload up to 25MB
    match /status_media/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
                      request.auth.uid == userId &&
                      request.resource.size <= 25 * 1024 * 1024 &&
                      (request.resource.contentType.matches('image/.*') ||
                       request.resource.contentType.matches('video/.*'));
    }
  }
}
